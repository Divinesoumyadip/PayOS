# ─────────────────────────────────────────
#  PayOS — Environment Variables
#  Copy this to .env and fill in your keys
# ─────────────────────────────────────────

# Hyperswitch Sandbox API Key
# Get from: https://app.hyperswitch.io → Developers → API Keys
HYPERSWITCH_API_KEY=your_hs_sandbox_key_here
HYPERSWITCH_BASE_URL=https://sandbox.hyperswitch.io

# Claude AI API Key (for PayAgent + AI features)
# Get from: https://console.anthropic.com
CLAUDE_API_KEY=your_claude_api_key_here

# PostgreSQL Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/payos

# Server
PORT=4000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
